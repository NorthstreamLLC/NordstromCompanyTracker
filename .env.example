# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL + anon key are safe to expose to the browser. RLS is what protects
# your data, which is why the policies in packages/db/migrations matter so much.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEVER expose this to the client. Server-side / edge functions only.
# It bypasses row-level security entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used by the migration runner only.
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ─── Plaid ───────────────────────────────────────────────────────────────────
# Start in sandbox. Production access requires a signed agreement and a security
# review by Plaid; allow several weeks. See docs/INTEGRATIONS.md.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
PLAID_WEBHOOK_URL=

# Encryption key for provider access tokens at rest (32 bytes, base64).
# Generate: openssl rand -base64 32
# Plaid access tokens must never be stored in plaintext and never reach the client.
TOKEN_ENCRYPTION_KEY=

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PERSONAL_MONTHLY=
STRIPE_PRICE_PERSONAL_YEARLY=
STRIPE_PRICE_HOUSEHOLD_MONTHLY=
STRIPE_PRICE_HOUSEHOLD_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="FinScope <noreply@example.com>"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=FinScope
NODE_ENV=development

# Set true to run integrations against local mocks with no external credentials.
MOCK_INTEGRATIONS=true
